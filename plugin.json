{
  "apiVersion": 1,
  "activationScope": "scoped",
  "id": "modera.filesystem",
  "name": "Filesystem",
  "version": "0.4.0",
  "description": "读取项目文件，预览并应用文件创建和文本编辑。",
  "author": "Modera",
  "category": "files",
  "icon": "folder",
  "main": "dist/index.cjs",
  "hostRenderers": {
    "write-result": {
      "entry": "write-result.js",
      "root": "dist/ui"
    }
  },
  "permissions": ["workspace.read", "workspace.write"],
  "extensions": ["tool.result", "tool.approval"],
  "agentGuidance": "Read relevant project files before editing. Keep writes scoped to the project, use returned versions for large-file continuation, and avoid unrelated changes.",
  "tools": [
    {
      "id": "filesystem_read",
      "description": "Read project text/directories, images (PNG/JPEG/GIF/WebP/BMP), PDF, Word (DOCX/DOC), spreadsheets (XLSX/XLS/XLSB/XLSM/ODS/CSV), and presentations (PPTX/PPT). Images return bounded visual data; GIF returns first frame. Documents extract plain text, not layout or OCR; legacy DOC/PPT recovery is incomplete. Use startLine/maxLines for text and documents; directory offset for listing; large plain text uses byte cursor/nextCursor. Carry version on continuation to reject changed files. Media <=32 MiB; text output bounded.",
      "locales": {
        "en": {
          "title": "Read file or directory"
        },
        "zh-CN": {
          "description": "读取文本、目录、图片及 PDF/Office 文档；支持分页和按行读取，文档提取正文，图片返回视觉数据。"
        }
      },
      "concurrency": "independent-read",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "version": {
            "maxLength": 200,
            "type": "string"
          },
          "cursor": {
            "minimum": 0,
            "type": "integer"
          },
          "encoding": {
            "description": "BOM and legacy text encoding detected; specify encoding when detection is ambiguous. Edits preserve the original encoding/BOM.",
            "enum": [
              "utf8",
              "utf16le",
              "utf16be",
              "gb18030",
              "big5",
              "shift_jis",
              "euc-kr",
              "windows-1252"
            ]
          },
          "maxLines": {
            "maximum": 200,
            "minimum": 1,
            "type": "integer"
          },
          "offset": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "startLine": {
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": ["path"],
        "type": "object"
      },
      "presentation": {
        "icon": "file",
        "kind": "file",
        "metrics": [
          {
            "format": "count",
            "label": "项",
            "labelEn": "items",
            "path": "entries"
          },
          {
            "format": "chars",
            "label": "字符",
            "labelEn": "chars",
            "path": "text"
          },
          {
            "format": "chars",
            "label": "字符",
            "labelEn": "chars",
            "path": "content"
          }
        ],
        "targets": ["path"],
        "tone": "blue"
      },
      "requiredPermissions": ["workspace.read"],
      "title": "读取文件或目录"
    },
    {
      "id": "filesystem_create",
      "description": "Create a project text file (UTF-8 default, optional encoding), creating parent directories when applied. Call once: the host previews the change and obtains approval before writing within this call. Existing files require overwrite=true and retain detected/explicit encoding. Changed files cause conflicts. Maximum 2 MiB; no symlinks or .git paths.",
      "locales": {
        "en": {
          "title": "Create file"
        },
        "zh-CN": {
          "description": "创建 UTF-8 文件，宿主在一次调用内预览并审批后写入；覆盖需显式指定。"
        }
      },
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "content": {
            "maxLength": 2097152,
            "type": "string"
          },
          "encoding": {
            "description": "BOM and legacy text encoding detected; specify encoding when detection is ambiguous. Edits preserve the original encoding/BOM.",
            "enum": [
              "utf8",
              "utf16le",
              "utf16be",
              "gb18030",
              "big5",
              "shift_jis",
              "euc-kr",
              "windows-1252"
            ]
          },
          "overwrite": {
            "type": "boolean"
          },
          "path": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": ["path", "content"],
        "type": "object"
      },
      "presentation": {
        "icon": "file",
        "kind": "edit",
        "metrics": [
          {
            "format": "number",
            "label": "字节",
            "labelEn": "bytes",
            "path": "bytes"
          }
        ],
        "targets": ["path"],
        "tone": "teal"
      },
      "requiredPermissions": ["workspace.read", "workspace.write"],
      "title": "创建文件"
    },
    {
      "id": "filesystem_replace_edit",
      "description": "Replace project text preserving original encoding/BOM and untouched newlines. LF/CRLF matching is supported; replacement adopts target newlines. Copy raw searchContent without line prefixes. Multiple matches require occurrence (1-based). Optional plugin settings enable indentation-preserving fuzzy matching (similarity >0.85) and formatting. Call once: host previews and approves the actual output before applying. Rejects stale files and no-op edits.",
      "locales": {
        "en": {
          "title": "Replace file text"
        },
        "zh-CN": {
          "description": "精确替换文件文本，保留 BOM 和未修改的换行；先预览再审批应用，冲突时拒绝写入。"
        }
      },
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "encoding": {
            "description": "BOM and legacy text encoding detected; specify encoding when detection is ambiguous. Edits preserve the original encoding/BOM.",
            "enum": [
              "utf8",
              "utf16le",
              "utf16be",
              "gb18030",
              "big5",
              "shift_jis",
              "euc-kr",
              "windows-1252"
            ]
          },
          "occurrence": {
            "maximum": 2097152,
            "minimum": 1,
            "type": "integer"
          },
          "path": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "replaceContent": {
            "maxLength": 2097152,
            "type": "string"
          },
          "searchContent": {
            "maxLength": 2097152,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": ["path", "searchContent", "replaceContent"],
        "type": "object"
      },
      "presentation": {
        "icon": "edit",
        "kind": "edit",
        "metrics": [
          {
            "format": "number",
            "label": "字节",
            "labelEn": "bytes",
            "path": "bytes"
          }
        ],
        "targets": ["path"],
        "tone": "amber"
      },
      "requiredPermissions": ["workspace.read", "workspace.write"],
      "title": "替换文件文本"
    }
  ],
  "locales": {
    "en": {
      "description": "Read project files, preview and apply file creation and exact text edits."
    },
    "zh-CN": {
      "name": "文件系统"
    }
  },
  "configScope": "scoped",
  "config": {
    "fuzzyMatching": {
      "default": false,
      "type": "boolean",
      "title": "Allow conservative fuzzy matching",
      "locales": {
        "zh-CN": {
          "title": "允许保守模糊匹配"
        }
      }
    },
    "autoFormat": {
      "default": false,
      "type": "boolean",
      "title": "Format edited files",
      "locales": {
        "zh-CN": {
          "title": "编辑后自动格式化"
        }
      }
    }
  }
}
