    "@modera/ui": "file:vendor/modera-ui-0.1.0.tgz",
    "@types/react": "^19.2.17",
    "react": "^19.1.1"
  },
  "dependencies": {
    "@jsquash/webp": "1.5.0",
    "cfb": "1.2.2",
    "chardet": "2.1.1",
    "fast-xml-parser": "5.3.8",
    "iconv-lite": "0.7.3",
    "ignore": "7.0.5",
    "image-size": "2.0.2",
    "jimp": "1.6.1",
    "jszip": "3.10.1",
    "mammoth": "1.13.0",
    "pdfjs-dist": "4.10.38",
    "prettier": "3.6.2",
    "supports-color": "8.1.1",
